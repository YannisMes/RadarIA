# =====================================================
# RadarIA - Variables d'environnement
# =====================================================
# Copie ce fichier en .env.local et remplis les valeurs.
# Ne commit JAMAIS le fichier .env.local

# -----------------------------------------------------
# App
# -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------
# Supabase
# -----------------------------------------------------
# A récupérer dans : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# /!\ JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------
# Gemini API (Google AI Studio)
# -----------------------------------------------------
# A récupérer sur https://aistudio.google.com/app/apikey
# /!\ JAMAIS exposer côté client
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------
# Stripe (paiements - configuration future)
# -----------------------------------------------------
# A récupérer sur https://dashboard.stripe.com/apikeys
# /!\ JAMAIS exposer côté client
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Clé publique Stripe (peut être exposée côté client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Price IDs Stripe (à créer dans le dashboard Stripe)
STRIPE_PRICE_PACK_EXAM=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxx
